@page "/"
@page "/dashboard"
@using Ligot.Web
@using Ligot.Web.Services
@inject DashboardApiClient DashboardApi
@inject AuthorizationService AuthService
@inject LocalizationService Localizer
@implements IDisposable

<PageTitle>@Localizer.GetString("Dashboard")</PageTitle>

<div class="container-fluid">
    <h2 class="mb-4">
        <i class="bi bi-speedometer2"></i> @Localizer.GetString("Dashboard")
    </h2>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">@Localizer.GetString("Loading")...</span>
            </div>
            <p class="mt-3">@Localizer.GetString("Loading dashboard metrics")...</p>
        </div>
    }
    else
    {
        @if (hasCasesAccess || hasProjectsAccess || hasPreSalesAccess)
        {
            <ul class="nav nav-pills mb-4">
                <li class="nav-item">
                    <button class="nav-link @(activeFilter == "all" ? "active" : "")"
                            @onclick='() => activeFilter = "all"'>
                        <i class="bi bi-grid"></i> @Localizer.GetString("All")
                    </button>
                </li>
                @if (hasCasesAccess)
                {
                    <li class="nav-item">
                        <button class="nav-link @(activeFilter == "cases" ? "active" : "")"
                                @onclick='() => activeFilter = "cases"'>
                            <i class="bi bi-folder2-open"></i> @Localizer.GetString("Cases")
                        </button>
                    </li>
                }
                @if (hasProjectsAccess)
                {
                    <li class="nav-item">
                        <button class="nav-link @(activeFilter == "projects" ? "active" : "")"
                                @onclick='() => activeFilter = "projects"'>
                            <i class="bi bi-kanban"></i> @Localizer.GetString("Projects")
                        </button>
                    </li>
                }
                @if (hasPreSalesAccess)
                {
                    <li class="nav-item">
                        <button class="nav-link @(activeFilter == "presales" ? "active" : "")"
                                @onclick='() => activeFilter = "presales"'>
                            <i class="bi bi-graph-up-arrow"></i> @Localizer.GetString("Pre-Sales")
                        </button>
                    </li>
                }
            </ul>
        }

        @if (hasCasesAccess && dashboard != null && (activeFilter == "all" || activeFilter == "cases"))
        {
            <CaseDashboardWidget CaseItems="dashboard.CaseItems" CaseStats="dashboard.CaseStats" />
        }

        @if (hasProjectsAccess && dashboard != null && (activeFilter == "all" || activeFilter == "projects"))
        {
            <ProjectDashboardWidget ProjectItems="dashboard.ProjectItems" ProjectStats="dashboard.ProjectStats" />
        }

        @if (hasPreSalesAccess && dashboard != null && (activeFilter == "all" || activeFilter == "presales"))
        {
            <PreSalesDashboardWidget PreSalesItems="dashboard.PreSalesItems" PreSalesStats="dashboard.PreSalesStats" />
        }

        @if (!hasCasesAccess && !hasProjectsAccess && !hasPreSalesAccess)
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> @Localizer.GetString("No dashboard data available for your current role.")
            </div>
        }
    }
</div>

@code {
    private PersonalDashboardDto? dashboard;
    private bool hasCasesAccess;
    private bool hasProjectsAccess;
    private bool hasPreSalesAccess;
    private bool isLoading = true;
    private string activeFilter = "all";

    protected override async Task OnInitializedAsync()
    {
        Localizer.OnLanguageChanged += OnLanguageChanged;

        var casesTask    = AuthService.HasPageAccessAsync("Cases");
        var projectsTask = AuthService.HasPageAccessAsync("Projects");
        var preSalesTask = AuthService.HasPageAccessAsync("PreSales");
        var dataTask     = DashboardApi.GetPersonalDashboardAsync();

        await Task.WhenAll(casesTask, projectsTask, preSalesTask, dataTask);

        hasCasesAccess    = casesTask.Result;
        hasProjectsAccess = projectsTask.Result;
        hasPreSalesAccess = preSalesTask.Result;
        dashboard         = dataTask.Result;

        isLoading = false;
    }

    private async void OnLanguageChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Localizer.OnLanguageChanged -= OnLanguageChanged;
    }
}


