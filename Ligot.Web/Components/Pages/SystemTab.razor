@using System.ComponentModel.DataAnnotations
@inject CustomerApiClient CustomerApi
@inject IJSRuntime JSRuntime
@inject Ligot.Web.Services.LocalizationService Localizer

<!-- Toast Notification Container -->
@if (!string.IsNullOrEmpty(toastMessage))
{
    <div class="position-sticky top-0 mb-3" style="z-index: 1050;">
        <div class="alert @(toastIsError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
            @toastMessage
            <button type="button" class="btn-close" @onclick="DismissToast"></button>
        </div>
    </div>
}

<div class="row">
    <div class="col-md-12">
        <h5>@Localizer.GetString("Systems")</h5>
        @if (Systems == null || !Systems.Any())
        {
            <p class="text-muted">@Localizer.GetString("No systems configured.")</p>
        }
        else
        {
            <div class="accordion" id="systemsAccordion">
                @foreach (var system in Systems)
                {
                    var accordionId = $"system-{system.Id}";
                    var componentCount = system.Components?.Count ?? 0;
                    var badgeClass = componentCount > 0 ? "bg-primary" : "bg-warning";
                    
                    <div class="accordion-item">
                        <h2 class="accordion-header d-flex align-items-center position-relative" id="heading-@system.Id" style="padding-right: 150px;">
                            <button class="accordion-button flex-grow-1" type="button" data-bs-toggle="collapse" 
                                    data-bs-target="#@accordionId" aria-expanded="true" aria-controls="@accordionId">
                                <span class="me-2">@system.SystemName</span>
                                <span class="badge @badgeClass me-2">@componentCount @Localizer.GetString("component(s)")</span>
                                @if (system.InstallationDate.HasValue)
                                {
                                    <small class="text-muted ms-2">@Localizer.GetString("Installed:") @system.InstallationDate.Value.ToShortDateString()</small>
                                }
                            </button>
                            <div class="position-absolute end-0 top-50 translate-middle-y me-2" style="z-index: 1050;">
                                <button class="btn btn-sm btn-outline-info me-1"
                                        @onclick="() => ShowSystemDetails(system)"
                                        @onclick:stopPropagation="true">
                                    <i class="bi bi-eye"></i>
                                </button>
                                @if (!IsReadOnly)
                                {
                                    <button class="btn btn-sm btn-outline-primary me-1" 
                                            @onclick="() => StartEditSystem(system)"
                                            @onclick:stopPropagation="true"
                                            disabled="@isDeletingSystem">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" 
                                            @onclick="() => DeleteSystemAsync(system.Id, system.SystemName, componentCount)"
                                            @onclick:stopPropagation="true"
                                            disabled="@isDeletingSystem">
                                        @if (isDeletingSystem)
                                        {
                                            <span class="spinner-border spinner-border-sm"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-trash"></i>
                                        }
                                    </button>
                                }
                            </div>
                        </h2>
                        <div id="@accordionId" class="accordion-collapse collapse show" 
                             aria-labelledby="heading-@system.Id" data-bs-parent="#systemsAccordion">
                            <div class="accordion-body">
                                @if (componentCount == 0)
                                {
                                    <div class="text-center py-3">
                                        <p class="text-muted mb-2">@Localizer.GetString("No components yet.")</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                        <table class="table table-sm table-hover mb-0">
                                            <thead>
                                                <tr>
                                                    <th>@Localizer.GetString("Component Type")</th>
                                                    <th>@Localizer.GetString("Manufacturer")</th>
                                                    <th>@Localizer.GetString("Model")</th>
                                                    <th>@Localizer.GetString("Serial Number")</th>
                                                    <th>@Localizer.GetString("Location")</th>
                                                    <th>@Localizer.GetString("Warranty Expiration")</th>
                                                    <th>@Localizer.GetString("Actions")</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var component in system.Components!)
                                                {
                                                    <tr>
                                                        <td>@component.ComponentType</td>
                                                        <td>@component.Manufacturer</td>
                                                        <td>@component.Model</td>
                                                        <td>@component.SerialNumber</td>
                                                        <td>@component.Location</td>
                                                        <td>@(component.WarrantyExpiration?.ToShortDateString() ?? "-")</td>
                                                        <td>
                                                            <button class="btn btn-sm btn-outline-info me-1"
                                                                    @onclick="() => ShowComponentDetails(component)">
                                                                <i class="bi bi-eye"></i>
                                                            </button>
                                                            @if (!IsReadOnly)
                                                            {
                                                                <button class="btn btn-sm btn-outline-primary me-1" 
                                                                        @onclick="() => StartEditComponent(system.Id, component)"
                                                                        disabled="@isDeletingComponent">
                                                                    <span class="bi bi-pencil"></span>
                                                                </button>
                                                                <button class="btn btn-sm btn-outline-danger" 
                                                                        @onclick="() => DeleteComponentAsync(system.Id, component.Id)"
                                                                        disabled="@isDeletingComponent">
                                                                    @if (isDeletingComponent)
                                                                    {
                                                                        <span class="spinner-border spinner-border-sm"></span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="bi bi-trash"></span>
                                                                    }
                                                                </button>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Add System and Component Forms -->
<div class="row mt-3">
    <div class="col-md-12">
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@Localizer.GetString("Add System")</h5>
                @if (!IsReadOnly)
                {
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => showAddSystemForm = !showAddSystemForm">
                        <i class="bi @(showAddSystemForm ? "bi-chevron-up" : "bi-chevron-down")"></i>
                    </button>
                }
            </div>
            @if (showAddSystemForm && !IsReadOnly)
            {
            <div class="card-body">
                <EditForm Model="newSystem" OnValidSubmit="CreateSystemAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" />
                    <div class="mb-2">
                        <label class="form-label">@Localizer.GetString("System Name")</label>
                        <InputText @bind-Value="newSystem.SystemName" class="form-control form-control-sm" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">@Localizer.GetString("Installation Date")</label>
                        <InputDate @bind-Value="newSystem.InstallationDate" class="form-control form-control-sm" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">@Localizer.GetString("Description")</label>
                        <InputTextArea @bind-Value="newSystem.Description" class="form-control form-control-sm" rows="2" />
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm w-100" disabled="@isAddingSystem">
                        @if (isAddingSystem)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        @Localizer.GetString("Add System")
                    </button>
                </EditForm>
                </div>
            }
        </div>
        
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@Localizer.GetString("Add Component")</h5>
                @if (!IsReadOnly)
                {
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => showAddComponentForm = !showAddComponentForm">
                        <i class="bi @(showAddComponentForm ? "bi-chevron-up" : "bi-chevron-down")"></i>
                    </button>
                }
            </div>
            @if (showAddComponentForm && !IsReadOnly)
            {
                <div class="card-body">
                @if (Systems == null || !Systems.Any())
                {
                    <p class="text-muted small">@Localizer.GetString("Add a system first")</p>
                }
                else
                {
                    <EditForm Model="newComponent" OnValidSubmit="CreateComponentAsync">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />
                        <div class="mb-2">
                            <label class="form-label">@Localizer.GetString("Select System")</label>
                            <InputSelect @bind-Value="selectedSystemId" class="form-control form-control-sm">
                                <option value="0">@Localizer.GetString("Select a system...")</option>
                                @foreach (var system in Systems)
                                {
                                    <option value="@system.Id">@system.SystemName</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">@Localizer.GetString("Component Type")</label>
                            <InputText @bind-Value="newComponent.ComponentType" class="form-control form-control-sm" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">@Localizer.GetString("Manufacturer")</label>
                            <InputText @bind-Value="newComponent.Manufacturer" class="form-control form-control-sm" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">@Localizer.GetString("Model")</label>
                            <InputText @bind-Value="newComponent.Model" class="form-control form-control-sm" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">@Localizer.GetString("Serial Number")</label>
                            <InputText @bind-Value="newComponent.SerialNumber" class="form-control form-control-sm" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">@Localizer.GetString("Location")</label>
                            <InputSelect @bind-Value="newComponent.Location" class="form-control form-control-sm">
                                <option value="">@Localizer.GetString("Select a site...")</option>
                                @foreach (var site in Sites)
                                {
                                    <option value="@site.SiteName">@site.SiteName</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">@Localizer.GetString("Warranty Expiration")</label>
                            <InputDate @bind-Value="newComponent.WarrantyExpiration" class="form-control form-control-sm" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">@Localizer.GetString("Description")</label>
                            <InputTextArea @bind-Value="newComponent.Description" class="form-control form-control-sm" rows="2" />
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm w-100" disabled="@(isAddingComponent || selectedSystemId == 0)">
                            @if (isAddingComponent)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            @Localizer.GetString("Add Component")
                        </button>
                    </EditForm>
                }
                </div>
            }
        </div>
    </div>
</div>

<!-- Edit System Modal -->
<div class="modal fade" id="editSystemModal" tabindex="-1" aria-labelledby="editSystemModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editSystemModalLabel">@Localizer.GetString("Edit System")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <EditForm Model="editSystem" OnValidSubmit="UpdateSystemAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" />
                    <div class="mb-3">
                        <label class="form-label">@Localizer.GetString("System Name")</label>
                        <InputText @bind-Value="editSystem.SystemName" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Localizer.GetString("Installation Date")</label>
                        <InputDate @bind-Value="editSystem.InstallationDate" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Localizer.GetString("Description")</label>
                        <InputTextArea @bind-Value="editSystem.Description" class="form-control" rows="3" />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary" disabled="@isEditingSystem">
                            @if (isEditingSystem)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            @Localizer.GetString("Save Changes")
                        </button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer.GetString("Cancel")</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

<!-- Edit Component Modal -->
<div class="modal fade" id="editComponentModal" tabindex="-1" aria-labelledby="editComponentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editComponentModalLabel">@Localizer.GetString("Edit Component")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <EditForm Model="editComponent" OnValidSubmit="UpdateComponentAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" />
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">@Localizer.GetString("Component Type")</label>
                            <InputText @bind-Value="editComponent.ComponentType" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@Localizer.GetString("Manufacturer")</label>
                            <InputText @bind-Value="editComponent.Manufacturer" class="form-control" />
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">@Localizer.GetString("Model")</label>
                            <InputText @bind-Value="editComponent.Model" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@Localizer.GetString("Serial Number")</label>
                            <InputText @bind-Value="editComponent.SerialNumber" class="form-control" />
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">@Localizer.GetString("Location")</label>
                            <InputSelect @bind-Value="editComponent.Location" class="form-control">
                                <option value="">@Localizer.GetString("Select a site...")</option>
                                @foreach (var site in Sites)
                                {
                                    <option value="@site.SiteName">@site.SiteName</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@Localizer.GetString("Warranty Expiration")</label>
                            <InputDate @bind-Value="editComponent.WarrantyExpiration" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Localizer.GetString("Description")</label>
                        <InputTextArea @bind-Value="editComponent.Description" class="form-control" rows="6" />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary" disabled="@isEditingComponent">
                            @if (isEditingComponent)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            @Localizer.GetString("Save Changes")
                        </button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer.GetString("Cancel")</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@if (selectedComponent != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Localizer.GetString("Component Details")</h5>
                    <button type="button" class="btn-close" @onclick="HideComponentDetails"></button>
                </div>
                <div class="modal-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5">@Localizer.GetString("Component Type")</dt>
                        <dd class="col-sm-7">@selectedComponent.ComponentType</dd>
                        <dt class="col-sm-5">@Localizer.GetString("Manufacturer")</dt>
                        <dd class="col-sm-7">@(selectedComponent.Manufacturer ?? "-")</dd>
                        <dt class="col-sm-5">@Localizer.GetString("Model")</dt>
                        <dd class="col-sm-7">@(selectedComponent.Model ?? "-")</dd>
                        <dt class="col-sm-5">@Localizer.GetString("Serial Number")</dt>
                        <dd class="col-sm-7">@(selectedComponent.SerialNumber ?? "-")</dd>
                        <dt class="col-sm-5">@Localizer.GetString("Location")</dt>
                        <dd class="col-sm-7">@(selectedComponent.Location ?? "-")</dd>
                        <dt class="col-sm-5">@Localizer.GetString("Warranty Expiration")</dt>
                        <dd class="col-sm-7">@(selectedComponent.WarrantyExpiration?.ToShortDateString() ?? "-")</dd>
                    </dl>
                    @if (!string.IsNullOrWhiteSpace(selectedComponent.Description))
                    {
                        <div class="mt-3">
                            <h6>@Localizer.GetString("Description")</h6>
                            <p class="mb-0 ms-3">@FormatDescription(selectedComponent.Description!)</p>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideComponentDetails">@Localizer.GetString("Close")</button>
                </div>
            </div>
        </div>
    </div>
}

@if (selectedSystem != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Localizer.GetString("System Details")</h5>
                    <button type="button" class="btn-close" @onclick="HideSystemDetails"></button>
                </div>
                <div class="modal-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5">@Localizer.GetString("System Name")</dt>
                        <dd class="col-sm-7">@selectedSystem.SystemName</dd>
                        @if (selectedSystem.InstallationDate.HasValue)
                        {
                            <dt class="col-sm-5">@Localizer.GetString("Installation Date")</dt>
                            <dd class="col-sm-7">@selectedSystem.InstallationDate.Value.ToShortDateString()</dd>
                        }
                    </dl>
                    @if (!string.IsNullOrWhiteSpace(selectedSystem.Description))
                    {
                        <div class="mt-3">
                            <h6>@Localizer.GetString("Description")</h6>
                            <p class="mb-0 ms-3">@FormatDescription(selectedSystem.Description!)</p>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideSystemDetails">@Localizer.GetString("Close")</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public int CustomerId { get; set; }

    [Parameter]
    public List<SystemDto> Systems { get; set; } = new();

    [Parameter]
    public List<CustomerSiteDto> Sites { get; set; } = new();

    [Parameter]
    public EventCallback OnRefresh { get; set; }

    [Parameter]
    public bool IsReadOnly { get; set; } = false;

    private SystemComponentDto? selectedComponent;
    private SystemDto? selectedSystem;

    // Toast notification
    private string? toastMessage;
    private bool toastIsError;
    private System.Threading.Timer? toastTimer;

    // Loading states
    private bool isAddingSystem;
    private bool isAddingComponent;
    private bool isEditingSystem;
    private bool isEditingComponent;
    private bool isDeletingSystem;
    private bool isDeletingComponent;

    // Form visibility
    private bool showAddSystemForm = false;
    private bool showAddComponentForm = false;

    // Form models
    private NewSystemModel newSystem = new();
    private NewComponentModel newComponent = new();
    private EditSystemModel editSystem = new();
    private EditComponentModel editComponent = new();
    
    private int selectedSystemId = 0;
    private int editingSystemId = 0;
    private int editingComponentSystemId = 0;
    private int editingComponentId = 0;

    private async Task CreateSystemAsync()
    {
        // Validate uniqueness
        if (Systems.Any(s => s.SystemName.Equals(newSystem.SystemName, StringComparison.OrdinalIgnoreCase)))
        {
            ShowToast("A system with this name already exists for this customer.", true);
            return;
        }

        isAddingSystem = true;
        try
        {
            var dto = new SystemCreateDto(
                newSystem.SystemName!,
                newSystem.InstallationDate,
                newSystem.Description);

            var result = await CustomerApi.AddNewSystemAsync(CustomerId, dto);
            if (result != null)
            {
                newSystem = new();
                await OnRefresh.InvokeAsync();
                ShowToast("System added successfully");
                showAddSystemForm = false;
            }
            else
            {
                ShowToast("Failed to add system: No response from server", true);
            }
        }
        catch (HttpRequestException ex)
        {
            ShowToast($"Network error: {ex.Message}", true);
        }
        catch (Exception ex)
        {
            ShowToast($"Error: {ex.Message}", true);
        }
        finally
        {
            isAddingSystem = false;
        }
    }

    private async Task CreateComponentAsync()
    {
        if (selectedSystemId == 0)
        {
            ShowToast("Please select a system first", true);
            return;
        }

        isAddingComponent = true;
        try
        {
            var dto = new SystemComponentCreateDto(
                newComponent.ComponentType!,
                newComponent.Manufacturer,
                newComponent.Model,
                newComponent.SerialNumber,
                newComponent.Location,
                newComponent.WarrantyExpiration,
                newComponent.Description);

            var result = await CustomerApi.AddSystemComponentAsync(CustomerId, selectedSystemId, dto);
            if (result != null)
            {
                newComponent = new();
                selectedSystemId = 0;
                await OnRefresh.InvokeAsync();
                ShowToast("Component added successfully");
                showAddComponentForm = false;
            }
            else
            {
                ShowToast("Failed to add component", true);
            }
        }
        catch (Exception ex)
        {
            ShowToast($"Error: {ex.Message}", true);
        }
        finally
        {
            isAddingComponent = false;
        }
    }

    private void SelectSystemForComponent(int systemId)
    {
        selectedSystemId = systemId;
    }

    private void ShowComponentDetails(SystemComponentDto component)
    {
        selectedComponent = component;
    }

    private void HideComponentDetails()
    {
        selectedComponent = null;
    }

    private void ShowSystemDetails(SystemDto system)
    {
        selectedSystem = system;
    }

    private void HideSystemDetails()
    {
        selectedSystem = null;
    }

    private static MarkupString FormatDescription(string description)
    {
        var lines = System.Text.RegularExpressions.Regex.Split(description, @"<br\s*/?>", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (lines.Length <= 1) return new MarkupString(description);
        var sb = new System.Text.StringBuilder();
        sb.Append(lines[0]);
        foreach (var line in lines.Skip(1))
            sb.Append($"<br><span class=\"ms-4 d-inline-block\">{line}</span>");
        return new MarkupString(sb.ToString());
    }

    private async Task StartEditSystem(SystemDto system)
    {
        editingSystemId = system.Id;
        editSystem = new EditSystemModel
        {
            SystemName = system.SystemName,
            InstallationDate = system.InstallationDate,
            Description = system.Description
        };
        await JSRuntime.InvokeVoidAsync("modalHelper.show", "editSystemModal");
    }

    private async Task UpdateSystemAsync()
    {
        isEditingSystem = true;
        try
        {
            var dto = new SystemDto(
                editingSystemId,
                CustomerId,
                editSystem.SystemName!,
                editSystem.InstallationDate,
                editSystem.Description,
                new List<SystemComponentDto>());

            var success = await CustomerApi.UpdateNewSystemAsync(CustomerId, editingSystemId, dto);
            if (success)
            {
                await JSRuntime.InvokeVoidAsync("modalHelper.hide", "editSystemModal");
                await OnRefresh.InvokeAsync();
                ShowToast("System updated successfully");
            }
            else
            {
                ShowToast("Failed to update system", true);
            }
        }
        catch (Exception ex)
        {
            ShowToast($"Error: {ex.Message}", true);
        }
        finally
        {
            isEditingSystem = false;
        }
    }

    private async Task DeleteSystemAsync(int systemId, string systemName, int componentCount)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", 
            $"Are you sure? This will delete '{systemName}' and all its {componentCount} component{(componentCount != 1 ? "s" : "")}.");
        
        if (!confirmed) return;

        isDeletingSystem = true;
        try
        {
            var success = await CustomerApi.DeleteNewSystemAsync(CustomerId, systemId);
            if (success)
            {
                await OnRefresh.InvokeAsync();
                ShowToast("System deleted successfully");
            }
            else
            {
                ShowToast("Failed to delete system", true);
            }
        }
        catch (Exception ex)
        {
            ShowToast($"Error: {ex.Message}", true);
        }
        finally
        {
            isDeletingSystem = false;
        }
    }

    private async Task StartEditComponent(int systemId, SystemComponentDto component)
    {
        editingComponentSystemId = systemId;
        editingComponentId = component.Id;
        editComponent = new EditComponentModel
        {
            ComponentType = component.ComponentType,
            Manufacturer = component.Manufacturer,
            Model = component.Model,
            SerialNumber = component.SerialNumber,
            Location = component.Location,
            WarrantyExpiration = component.WarrantyExpiration,
            Description = component.Description
        };
        await JSRuntime.InvokeVoidAsync("modalHelper.show", "editComponentModal");
    }

    private async Task UpdateComponentAsync()
    {
        isEditingComponent = true;
        try
        {
            var dto = new SystemComponentDto(
                editingComponentId,
                editingComponentSystemId,
                editComponent.ComponentType!,
                editComponent.Manufacturer,
                editComponent.Model,
                editComponent.SerialNumber,
                editComponent.Location,
                editComponent.WarrantyExpiration,
                editComponent.Description);

            var success = await CustomerApi.UpdateSystemComponentAsync(CustomerId, editingComponentSystemId, editingComponentId, dto);
            if (success)
            {
                await JSRuntime.InvokeVoidAsync("modalHelper.hide", "editComponentModal");
                await OnRefresh.InvokeAsync();
                ShowToast("Component updated successfully");
            }
            else
            {
                ShowToast("Failed to update component", true);
            }
        }
        catch (Exception ex)
        {
            ShowToast($"Error: {ex.Message}", true);
        }
        finally
        {
            isEditingComponent = false;
        }
    }

    private async Task DeleteComponentAsync(int systemId, int componentId)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Delete this component?");
        if (!confirmed) return;

        isDeletingComponent = true;
        try
        {
            var success = await CustomerApi.DeleteSystemComponentAsync(CustomerId, systemId, componentId);
            if (success)
            {
                await OnRefresh.InvokeAsync();
                ShowToast("Component deleted successfully");
            }
            else
            {
                ShowToast("Failed to delete component", true);
            }
        }
        catch (Exception ex)
        {
            ShowToast($"Error: {ex.Message}", true);
        }
        finally
        {
            isDeletingComponent = false;
        }
    }

    private void ShowToast(string message, bool isError = false)
    {
        toastMessage = message;
        toastIsError = isError;
        
        // Auto-dismiss after 3 seconds
        toastTimer?.Dispose();
        toastTimer = new System.Threading.Timer(_ =>
        {
            toastMessage = null;
            InvokeAsync(StateHasChanged);
        }, null, 3000, Timeout.Infinite);
    }

    private void DismissToast()
    {
        toastMessage = null;
        toastTimer?.Dispose();
    }

    public void Dispose()
    {
        toastTimer?.Dispose();
    }

