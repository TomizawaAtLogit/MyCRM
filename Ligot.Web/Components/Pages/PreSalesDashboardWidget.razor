@using Ligot.Web
@using Ligot.Web.Services
@inject LocalizationService Localizer

<div class="card mb-4">
    <div class="card-header bg-warning text-dark d-flex align-items-center">
        <i class="bi bi-graph-up-arrow me-2"></i>
        <h5 class="mb-0">@Localizer.GetString("Pre-sales Pipeline")</h5>
    </div>
    <div class="card-body">

        <div class="row mb-3 g-2">
            <div class="col-6 col-md-4">
                <div class="border rounded p-2 text-center">
                    <div class="fw-bold fs-4 text-primary">@PreSalesStats.InPipeline</div>
                    <small class="text-muted">@Localizer.GetString("In Pipeline")</small>
                </div>
            </div>
            <div class="col-6 col-md-4">
                <div class="border rounded p-2 text-center">
                    <div class="fw-bold fs-4 text-success">@PreSalesStats.Won</div>
                    <small class="text-muted">@Localizer.GetString("Won")</small>
                </div>
            </div>
            <div class="col-6 col-md-4">
                <div class="border rounded p-2 text-center">
                    <div class="fw-bold fs-4 text-danger">@PreSalesStats.LostOrRejected</div>
                    <small class="text-muted">@Localizer.GetString("Lost / Rejected")</small>
                </div>
            </div>
        </div>

        @if (!PreSalesItems.Any())
        {
            <div class="text-muted text-center py-3">
                <i class="bi bi-check-circle"></i> @Localizer.GetString("No active proposals in your coverage.")
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Localizer.GetString("Status")</th>
                            <th>@Localizer.GetString("Stage")</th>
                            <th>@Localizer.GetString("Title")</th>
                            <th>@Localizer.GetString("Customer")</th>
                            <th>@Localizer.GetString("Probability")</th>
                            <th>@Localizer.GetString("Expected Close")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in PreSalesItems)
                        {
                            var statusColor = GetStatusBadgeColor(item.Status);
                            <tr>
                                <td>
                                    <span class="badge bg-@statusColor">@Localizer.GetString($"PreSalesStatus.{item.Status}")</span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@Localizer.GetString($"PreSalesStage.{item.Stage}")</span>
                                </td>
                                <td>
                                    <a href="/presales" class="text-decoration-none">@item.Title</a>
                                </td>
                                <td>@item.CustomerName</td>
                                <td>
                                    @if (item.ProbabilityPercentage.HasValue)
                                    {
                                        <span>@item.ProbabilityPercentage%</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (item.ExpectedCloseDate.HasValue)
                                    {
                                        @item.ExpectedCloseDate.Value.ToLocalTime().ToString("MMM d, yyyy")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public List<DashboardPreSalesItem> PreSalesItems { get; set; } = [];
    [Parameter, EditorRequired] public DashboardPreSalesStats PreSalesStats { get; set; } = new(0, 0, 0);

    private string GetStatusBadgeColor(PreSalesStatus status) => status switch
    {
        PreSalesStatus.Draft    => "secondary",
        PreSalesStatus.InReview => "info",
        PreSalesStatus.Pending  => "warning",
        PreSalesStatus.Approved => "success",
        PreSalesStatus.Rejected => "danger",
        _                       => "dark"
    };
}
