@using Ligot.Web
@using Ligot.Web.Services
@inject LocalizationService Localizer

<div class="card mb-4">
    <div class="card-header bg-success text-white d-flex align-items-center">
        <i class="bi bi-kanban me-2"></i>
        <h5 class="mb-0">@Localizer.GetString("My Projects")</h5>
    </div>
    <div class="card-body">

        <div class="row mb-3 g-2">
            <div class="col-6 col-md-4">
                <div class="border rounded p-2 text-center">
                    <div class="fw-bold fs-4 text-primary">@ProjectStats.ActiveProjects</div>
                    <small class="text-muted">@Localizer.GetString("Active")</small>
                </div>
            </div>
            <div class="col-6 col-md-4">
                <div class="border rounded p-2 text-center">
                    <div class="fw-bold fs-4 text-success">@ProjectStats.CompletedProjects</div>
                    <small class="text-muted">@Localizer.GetString("Completed")</small>
                </div>
            </div>
            <div class="col-6 col-md-4">
                <div class="border rounded p-2 text-center">
                    <div class="fw-bold fs-4 text-warning">@ProjectStats.OnHoldProjects</div>
                    <small class="text-muted">@Localizer.GetString("On Hold")</small>
                </div>
            </div>
        </div>

        @if (!ProjectItems.Any())
        {
            <div class="text-muted text-center py-3">
                <i class="bi bi-check-circle"></i> @Localizer.GetString("No active projects in your coverage.")
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Localizer.GetString("Status")</th>
                            <th>@Localizer.GetString("Name")</th>
                            <th>@Localizer.GetString("Customer")</th>
                            <th>@Localizer.GetString("Started")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in ProjectItems)
                        {
                            var (stsCss, stsText) = GetStatusBadge(item.Status);
                            <tr>
                                <td><span class="@stsCss">@stsText</span></td>
                                <td>
                                    <a href="/projects?projectId=@item.Id" class="text-decoration-none">@item.Name</a>
                                </td>
                                <td>@item.CustomerName</td>
                                <td>@item.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public List<DashboardProjectItem> ProjectItems { get; set; } = [];
    [Parameter, EditorRequired] public DashboardProjectStats ProjectStats { get; set; } = new(0, 0, 0);

    private (string CssClass, string Text) GetStatusBadge(ProjectStatus status) => status switch
    {
        ProjectStatus.Wip     => ("badge bg-primary", "WIP"),
        ProjectStatus.Pending => ("badge bg-warning text-dark", Localizer.GetString("On Hold")),
        _                     => ("badge bg-secondary", Localizer.GetString("Closed"))
    };
}
